/* 全局样式 - 嫩黄卡通风 */
page {
  --bg: #FFF7E0;
  --bg-card: #FFFFFF;
  --bg-input: #FFF2C8;
  --border: #FFE3A6;
  --text: #4A3829;
  --text-secondary: #8A6A4F;
  --text-dim: #B08D63;
  --accent: #FFD23F;
  --accent-strong: #F5A623;
  --accent-deep: #8A5A00;
  --red: #F2494B;
  --red-bg: #FFE3DE;
  --green: #1FA35C;
  --green-bg: #DFF6E7;
  --blue: #3D7BFF;
  --blue-bg: #E3ECFF;
  --shadow: 0 6rpx 20rpx rgba(228, 166, 42, 0.16);
  --shadow-soft: 0 4rpx 12rpx rgba(228, 166, 42, 0.10);

  height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  display: flex;
  flex-direction: column;
}

.scrollarea {
  flex: 1;
  overflow-x: hidden;
  overflow-y: auto;
  padding: 24rpx 32rpx 48rpx;
  width: 100%;
  box-sizing: border-box;
}

.red { color: var(--red); }
.green { color: var(--green); }
.blue { color: var(--blue); }

.weui-navigation-bar { --weui-FG-0: #5B4636; }

/* ========== 圆角悬浮底部导航 ========== */
.bottom-bar {
  position: fixed;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  right: 24rpx;
  z-index: 200;
  display: flex;
  align-items: center;
  background: #FFFDF5;
  border: 2rpx solid var(--border);
  border-radius: 32rpx;
  box-shadow: var(--shadow);
  padding: 8rpx 14rpx;
}
.bb-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 0;
}
.bb-icon {
  width: 56rpx;
  height: 56rpx;
  display: block;
  opacity: 0.72;
  background-color: var(--accent-strong);
  transition: transform 0.15s;
}
.bb-img {
  width: 56rpx;
  height: 56rpx;
  display: block;
  opacity: 0.72;
  transition: transform 0.15s;
}
.bb-img-market {
  width: 72rpx;
  height: 72rpx;
}
