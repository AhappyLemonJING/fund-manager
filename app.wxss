.bb-active .bb-icon,
.bb-active .bb-img {
  opacity: 1;
  transform: translateY(-3rpx);
}
.bb-label {
  font-size: 22rpx;
  color: var(--text-dim);
  font-weight: 600;
}
.bb-active .bb-label {
  color: var(--accent-deep);
  font-weight: 800;
}

/* ========== 加载中圆环 ========== */
.state-spinner {
  width: 84rpx;
  height: 84rpx;
  display: block;
  margin: 0 auto;
  border: 6rpx solid var(--border);
  border-top-color: var(--accent-strong);
  border-radius: 50%;
  animation: uiSpin 1s linear infinite;
}
@keyframes uiSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
