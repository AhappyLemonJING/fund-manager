page { background: var(--bg); width: 100%; overflow-x: hidden; }

/* 更新栏 */
.update-bar { text-align: right; padding: 8rpx 32rpx 20rpx; }
.update-text { font-size: 20rpx; color: var(--text-dim); }

/* 状态框 */
.state-box { text-align: center; padding: 240rpx 0; }
.state-icon {
  width: 96rpx; height: 96rpx; opacity: 0.75;
  display: block; margin: 0 auto;
  background-color: var(--accent-strong);
}
.chick-state {
  width: 280rpx; height: 280rpx;
  display: block; margin: 0 auto;
}
.state-text { margin-top: 20rpx; color: var(--text-secondary); font-size: 28rpx; }
.state-sub { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--text-dim); }
.retry-btn {
  display: inline-block; margin-top: 36rpx; padding: 18rpx 56rpx;
  background: var(--accent); color: var(--accent-deep); border-radius: 40rpx;
  font-weight: 800; font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 166, 35, 0.26);
}

/* ====== 大盘概览 ====== */
.overview {
  margin: 0 24rpx 20rpx; padding: 6rpx 0;
  background: var(--bg-card); border: 2rpx solid var(--border);
  border-radius: 28rpx; overflow: hidden;
  box-shadow: var(--shadow-soft);
}
.ov-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 28rpx;
  border-bottom: 2rpx dashed var(--border);
}
.ov-item:last-child { border-bottom: none; }
.ov-name {
  font-size: 26rpx; font-weight: 800; width: 100rpx; flex-shrink: 0;
}
.ov-price { font-size: 30rpx; font-weight: 700; flex: 1; }
.ov-change {
  padding: 8rpx 18rpx; border-radius: 20rpx; font-size: 24rpx;
  font-weight: 700; min-width: 120rpx; text-align: center;
}
.ov-change.red { background: var(--red-bg); color: var(--red); }
.ov-change.green { background: var(--green-bg); color: var(--green); }

/* ====== 涨跌统计条 ====== */
.breadth-bar {
  display: flex; align-items: center; justify-content: center;
  margin: 0 24rpx 24rpx; padding: 18rpx 0;
  background: #FFFDF5; border: 2rpx solid var(--border);
  border-radius: 28rpx; gap: 0;
  box-shadow: var(--shadow-soft);
}
.br-item { display: flex; align-items: center; gap: 10rpx; }
.br-label { font-size: 22rpx; color: var(--text-dim); }
.br-num { font-size: 32rpx; font-weight: 700; }
.br-divider {
  width: 1px; height: 32rpx; margin: 0 40rpx;
  background: #FFE3A6;
}

/* ====== 行业板块列表 ====== */
.sector-list {
  margin: 0 24rpx; background: var(--bg-card);
  border: 2rpx solid var(--border); border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-soft);
}
.sl-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 22rpx 24rpx;
  border-bottom: 2rpx dashed var(--border);
}
.sl-row:last-child { border-bottom: none; }
.sl-left { flex: 1; min-width: 0; }
.sl-name { font-size: 26rpx; font-weight: 800; display: block; margin-bottom: 10rpx; }
.sl-bar-bg {
  height: 10rpx; border-radius: 6rpx;
  background: #FFF0C6; overflow: hidden;
  width: 100%;
}
.sl-bar { height: 100%; border-radius: 6rpx; min-width: 4rpx; }
.bg-red { background: var(--red); }
.bg-green { background: var(--green); }
.sl-pct { font-size: 28rpx; font-weight: 700; min-width: 110rpx; text-align: right; }
