<navigation-bar title="基金管理" back="{{false}}" color="white" background="#0d1117"></navigation-bar>
<!-- 云同步状态栏 -->
<view class="sync-bar">
  <text class="sync-status">{{syncing ? '同步中...' : (lastSyncTime ? '上次同步: ' + lastSyncTime : '未同步')}}</text>
  <view class="sync-btn {{syncing ? 'syncing' : ''}}" bindtap="doSync">
    <text>{{syncing ? '⟳' : '☁️'}}</text>
  </view>
</view>

<!-- 首次同步确认弹窗 -->
<view wx:if="{{showSyncConfirm}}" class="modal-mask" bindtap="hideSyncConfirm">
  <view class="modal modal-confirm" catch:tap="noop">
    <view class="modal-title">首次云同步</view>
    <view class="confirm-text">检测到云端可能已有数据。<text style="display:block;font-size:24rpx;color:var(--text-dim);margin-top:12rpx;">将合并本地与云端数据（保留最新版本）</text></view>
    <view class="modal-btns">
      <view class="btn btn-cancel" bindtap="hideSyncConfirm">取消</view>
      <view class="btn btn-ok" bindtap="confirmSync">开始同步</view>
    </view>
  </view>
</view>

<!-- 持仓概况 (仅持仓tab显示) -->
<view wx:if="{{activeTab === 'position' && portfolio.items.length > 0}}" class="pf-summary">
  <view class="pf-row">
    <view class="pf-item">
      <text class="pf-label">总资产</text>
      <text class="pf-val pf-val-main">{{portfolio.totalMarketStr}}</text>
    </view>
    <view class="pf-divider"></view>
    <view class="pf-item">
      <text class="pf-label">总成本</text>
      <text class="pf-val pf-val-cost">{{portfolio.totalCostStr}}</text>
    </view>
    <view class="pf-divider"></view>
    <view class="pf-item">
      <text class="pf-label">持仓收益</text>
      <view class="pf-profit-line">
        <text class="pf-val {{portfolio.totalProfit >= 0 ? 'red' : 'green'}}">{{portfolio.totalProfitStr}}</text>
        <text class="pf-pct {{portfolio.totalProfit >= 0 ? 'red' : 'green'}}">{{portfolio.totalPctStr}}%</text>
      </view>
    </view>
  </view>
</view>

<!-- 主 Tab 栏：持仓 / 自选 -->
<view class="main-tabs">
  <view class="main-tab {{activeTab === 'position' ? 'main-tab-active' : ''}}" bindtap="switchTab" data-id="position">
    <text>持仓</text>
    <text wx:if="{{activeTab === 'position' && portfolio.items.length > 0}}" class="main-tab-badge">{{portfolio.items.length}}</text>
  </view>
  <view class="main-tab {{activeTab === 'watch' ? 'main-tab-active' : ''}}" bindtap="switchTab" data-id="watch">
    自选
  </view>
</view>

<!-- 分组 Tab 栏 -->
<scroll-view class="tab-bar" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
  <view wx:for="{{tabs}}" wx:key="id" class="tab-item {{activeGroup === item.id ? 'tab-active' : ''}}" bindtap="switchGroup" bindlongpress="longPressTab" data-id="{{item.id}}" data-name="{{item.name}}">
    {{item.name}}
  </view>
  <view class="tab-item tab-add-group" bindtap="showGroupMgr">+ 分组</view>
  <view class="tab-bar-spacer"></view></scroll-view>

<scroll-view class="scrollarea" scroll-y type="list"
  refresher-enabled refresher-triggered="{{refreshing}}"
  bindrefresherrefresh="onRefresh" refresher-threshold="80">
  <view wx:if="{{loading}}" style="text-align:center;padding:200rpx 0;">
    <text style="color:var(--text-dim);">加载中...</text>
  </view>
  <view wx:elif="{{displayFunds.length === 0}}" style="text-align:center;padding:240rpx 0 80rpx;">
    <text style="font-size:100rpx;opacity:0.4;">📊</text>
    <view style="margin-top:30rpx;color:var(--text-secondary);font-size:28rpx;line-height:1.6;">
      {{activeTab === 'position' ? '还没有持仓基金' : '还没有自选基金'}}<text style="display:block;">点击下方按钮添加</text>
    </view>
    <view style="margin-top:40rpx;padding:20rpx 60rpx;background:var(--accent);color:#000;border-radius:40rpx;font-weight:600;font-size:28rpx;display:inline-block;" bindtap="showAddModal">+ 添加基金</view>
  </view>
  <view wx:else>
    <view wx:for="{{displayFunds}}" wx:key="code" class="card" bindtap="goDetail" data-index="{{index}}">
      <view class="card-top">
        <view class="card-info">
          <view class="card-code-name">
            <text class="card-code">{{item.code}}</text>
            <text class="card-name">{{item.name || '加载中'}}</text>
          </view>
        </view>
        <view class="card-price">
          <text class="card-nav">{{item.nav != null ? item.nav : '--'}}</text>
          <text class="card-pct {{item.changePct >= 0 ? 'red' : 'green'}}">
            {{item.changePct != null ? (item.changePct >= 0 ? '+' : '') + item.changePct : '--'}}%
          </text>
        </view>
      </view>
      <!-- 持仓盈亏行 (仅持仓tab) -->
      <view wx:if="{{activeTab === 'position' && portfolio}}" class="card-pl">
        <block wx:for="{{portfolio.items}}" wx:key="code" wx:for-item="pi">
          <view wx:if="{{pi.code === item.code && pi.pl.override}}" class="pl-row">
            <text class="pl-cost">持仓 {{pi.pl.marketValueStr}}元 · {{pi.pl.holdingDaysStr}}</text>
            <text class="pl-profit {{pi.pl.profit >= 0 ? 'red' : 'green'}}">
              {{pi.pl.profitStr}}({{pi.pl.profitPctStr}}%)
            </text>
          </view>
          <view wx:elif="{{pi.code === item.code}}" class="pl-row">
            <text class="pl-cost">成本 {{pi.pl.avgCostStr}} · {{pi.pl.sharesStr}}份</text>
            <text class="pl-profit {{pi.pl.profit >= 0 ? 'red' : 'green'}}">
              {{pi.pl.profitStr}}({{pi.pl.profitPctStr}}%)
            </text>
          </view>
          <view wx:if="{{pi.code === item.code && pi.pl.holdingDays > 0 && !pi.pl.override}}" class="pl-row">
            <text></text>
            <text class="pl-days">持有{{pi.pl.holdingDays}}天</text>
          </view>
        </block>
      </view>
      <view class="card-bottom">
        <view wx:if="{{activeTab === 'position'}}" class="c-action c-trade" catchtap="showTrade" data-index="{{index}}">
          <text>交易</text>
        </view>
        <view wx:else class="c-type-tag {{item._type === 'position' ? 'c-type-pos' : 'c-type-watch'}}" catchtap="showSwitchType" data-index="{{index}}">
          {{item._type === 'position' ? '持仓' : '自选'}}
        </view>
        <view class="c-group" catchtap="showMoveGroup" data-index="{{index}}">
          <text class="c-group-label">{{item._groupName}}</text>
          <text class="c-group-arrow">›</text>
        </view>
        <view class="c-del" catchtap="confirmDelete" data-index="{{index}}">✕</view>
      </view>
    </view>
    <view style="text-align:center;padding:32rpx 0 60rpx;" bindtap="showAddModal">
      <text style="color:var(--accent);font-size:28rpx;border:1px solid var(--border);border-radius:40rpx;padding:16rpx 60rpx;">+ 添加基金</text>
    </view>
  </view>
</scroll-view>

<!-- 添加基金弹窗 -->
<view wx:if="{{showAddModal}}" class="modal-mask" bindtap="hideAddModal">
  <view class="modal" catch:tap="noop">
    <view class="modal-title">添加基金</view>
    <!-- 类型选择 -->
    <view class="modal-label">类型</view>
    <view style="display:flex;gap:16rpx;">
      <view class="type-pick {{addType === 'watch' ? 'type-pick-sel' : ''}}" bindtap="pickType" data-id="watch">加入自选</view>
      <view class="type-pick {{addType === 'position' ? 'type-pick-sel' : ''}}" bindtap="pickType" data-id="position">加入持仓</view>
    </view>
    <!-- 基金代码 -->
    <view class="modal-label" style="margin-top:20rpx;">基金代码</view>
    <input class="modal-input" placeholder="例如: 000001" placeholder-style="color:#6e7681" value="{{inputCode}}" bindinput="onInputCode" maxlength="6" type="number"/>
    <view class="modal-hint">输入6位数字基金代码</view>
    <!-- 分组选择 -->
    <view class="modal-label" style="margin-top:24rpx;">分组</view>
    <scroll-view class="group-picker" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="gp-item {{addGroupId === '' ? 'gp-sel' : ''}}" bindtap="pickGroup" data-id="">未分组</view>
      <view wx:for="{{groups}}" wx:key="id" class="gp-item {{addGroupId === item.id ? 'gp-sel' : ''}}" bindtap="pickGroup" data-id="{{item.id}}">{{item.name}}</view>
      <view class="gp-item gp-new" bindtap="quickAddGroup">+新建</view>
    </scroll-view>
    <!-- 按钮 -->
    <view class="modal-btns">
      <view class="btn btn-cancel" bindtap="hideAddModal">取消</view>
      <view class="btn btn-ok {{adding ? 'btn-disabled' : ''}}" bindtap="addFund">确认添加</view>
    </view>
  </view>
</view>

<!-- 交易记录弹窗 -->
<view wx:if="{{showTradeModal}}" class="modal-mask" bindtap="hideTrade">
  <view class="modal" catch:tap="noop" style="width:640rpx;max-height:85vh;overflow-y:auto;">
    <view class="modal-title">{{tradeFundName}}交易记录</view>
    <!-- 当前盈亏 -->
    <view wx:if="{{tradePl.shares > 0}}" class="trade-pl-summary">
      <view class="tps-row">
        <text class="tps-label">持仓份额</text><text class="tps-val">{{tradePl.sharesStr}}份</text>
      </view>
      <view class="tps-row">
        <text class="tps-label">成本均价</text><text class="tps-val">{{tradePl.avgCostStr}}</text>
      </view>
      <view class="tps-row">
        <text class="tps-label">持仓市值</text><text class="tps-val">{{tradePl.marketValueStr}}</text>
      </view>
      <view class="tps-row tps-profit {{tradePl.profit >= 0 ? 'red' : 'green'}}">
        <text class="tps-label">浮动盈亏</text>
<text class="tps-val">{{tradePl.profitStr}} ({{tradePl.profitPctStr}}%)</text>
      </view>
    </view>
    <view wx:elif="{{tradeFundNav}}" style="text-align:center;padding:20rpx;color:var(--text-dim);font-size:24rpx;">
      暂无交易记录，当前净值 {{tradeFundNav}}
    </view>
    <!-- 手动覆盖编辑 -->
    <view class="trade-pos-edit">
      <view class="sec-title-sm">持仓覆盖编辑</view>
      <view class="tpe-row">
        <text class="tpe-label">持仓金额(元)</text>
        <input class="modal-input tpe-input" placeholder="{{tradePl.marketValueStr}}" placeholder-style="color:#6e7681" value="{{editMarketValue}}" bindinput="onEditMarketValue" type="digit"/>
      </view>
      <view class="tpe-row">
        <text class="tpe-label">持有收益(元)</text>
        <input class="modal-input tpe-input" placeholder="{{tradePl.profitStr}}" placeholder-style="color:#6e7681" value="{{editProfit}}" bindinput="onEditProfit" type="digit"/>
      </view>
      <view class="tpe-row">
        <text class="tpe-label">持有天数</text>
        <input class="modal-input tpe-input" placeholder="例如: 30" placeholder-style="color:#6e7681" value="{{editHoldingDays}}" bindinput="onEditHoldingDays" type="number"/>
      </view>
      <view class="tpe-btns">
        <view class="btn btn-sm btn-cancel" bindtap="clearPosOverride">清除</view>
        <view class="btn btn-sm btn-ok" bindtap="savePosOverride">保存</view>
      </view>
    </view>
    <!-- 历史交易 -->
    <view wx:if="{{tradeRecords.length > 0}}" class="trade-hist">
      <view class="sec-title-sm">历史记录</view>
      <view wx:for="{{tradeRecords}}" wx:key="id" class="tr-item">
        <view class="tr-left">
          <text class="tr-type {{item.type === 'buy' ? 'red' : 'green'}}">{{item.type === 'buy' ? '买入' : '卖出'}}</text>
          <text class="tr-date">{{item.date}}</text>
        </view>
        <view class="tr-right">
          <text class="tr-detail">{{item.shares}}份 / {{item.amountStr}}元</text>
          <text class="tr-del" bindtap="deleteTrade" data-index="{{index}}">✕</text>
        </view>
      </view>
    </view>
    <!-- 新增交易 -->
    <view class="trade-form">
      <view class="sec-title-sm">新增记录</view>
      <view style="display:flex;gap:16rpx;margin-bottom:16rpx;">
        <view class="type-pick {{tradeType === 'buy' ? 'type-pick-sel' : ''}}" bindtap="onTradeType" data-id="buy" style="flex:1;text-align:center;">买入</view>
        <view class="type-pick {{tradeType === 'sell' ? 'type-pick-sel' : ''}}" bindtap="onTradeType" data-id="sell" style="flex:1;text-align:center;">卖出</view>
      </view>
      <input class="modal-input" style="margin-bottom:12rpx;" placeholder="份额" placeholder-style="color:#6e7681" value="{{tradeShares}}" bindinput="onTradeShares" type="digit"/>
      <input class="modal-input" style="margin-bottom:12rpx;" placeholder="金额 (元)" placeholder-style="color:#6e7681" value="{{tradeAmount}}" bindinput="onTradeAmount" type="digit"/>
      <picker mode="date" value="{{tradeDate}}" bindchange="onTradeDateChange">
        <view class="picker-display">{{tradeDate || '选择日期'}}</view>
      </picker>
      <view class="trade-time-row">
        <view class="type-pick {{tradeIsBefore3pm ? 'type-pick-sel' : ''}}" bindtap="onTradeTime" data-id="before" style="flex:1;text-align:center;font-size:24rpx;">下午三点前</view>
        <view class="type-pick {{!tradeIsBefore3pm ? 'type-pick-sel' : ''}}" bindtap="onTradeTime" data-id="after" style="flex:1;text-align:center;font-size:24rpx;">下午三点后</view>
      </view>
      <view class="modal-btns">
        <view class="btn btn-cancel" bindtap="hideTrade">关闭</view>
        <view class="btn btn-ok" bindtap="addTrade">记录</view>
      </view>
    </view>
  </view>
</view>

<!-- 切换类型弹窗 -->
<view wx:if="{{showSwitchTypeModal}}" class="modal-mask" bindtap="hideSwitchType">
  <view class="modal" catch:tap="noop">
    <view class="modal-title">切换状态</view>
    <view style="display:flex;gap:16rpx;">
      <view class="type-pick {{switchTypeTarget === 'watch' ? 'type-pick-sel' : ''}}" bindtap="confirmSwitchType" data-id="watch">自选</view>
      <view class="type-pick {{switchTypeTarget === 'position' ? 'type-pick-sel' : ''}}" bindtap="confirmSwitchType" data-id="position">持仓</view>
    </view>
    <view style="margin-top:28rpx;text-align:center;">
      <view class="btn btn-cancel" bindtap="hideSwitchType">关闭</view>
    </view>
  </view>
</view>

<!-- 分组管理弹窗 -->
<view wx:if="{{showGroupModal}}" class="modal-mask" bindtap="hideGroupMgr">
  <view class="modal" catch:tap="noop" style="max-height:80vh;overflow-y:auto;">
    <view class="modal-title">管理分组</view>
    <view wx:for="{{groups}}" wx:key="id" class="gm-row">
      <text wx:if="{{gmEditId !== item.id}}" class="gm-name">{{item.name}}</text>
      <input wx:else class="gm-input" value="{{gmEditName}}" bindinput="onGmInput" maxlength="10" focus="{{true}}"/>
      <view class="gm-actions">
        <text wx:if="{{gmEditId !== item.id}}" class="gm-btn" bindtap="startRename" data-id="{{item.id}}" data-name="{{item.name}}">重命名</text>
        <text wx:else class="gm-btn gm-ok" bindtap="confirmRename" data-id="{{item.id}}">✓</text>
        <text wx:if="{{gmEditId !== item.id}}" class="gm-btn gm-del" bindtap="confirmDelGroup" data-id="{{item.id}}" data-name="{{item.name}}">删除</text>
        <text wx:else class="gm-btn" bindtap="cancelRename">取消</text>
      </view>
    </view>
    <view wx:if="{{groups.length === 0}}" style="color:var(--text-dim);font-size:26rpx;text-align:center;padding:20rpx;">暂无自定义分组</view>
    <view style="display:flex;gap:16rpx;margin-top:24rpx;">
      <input class="gm-input" style="flex:1;" placeholder="输入分组名称" placeholder-style="color:#6e7681" value="{{newGroupName}}" bindinput="onNewGroupInput" maxlength="10"/>
      <view class="btn btn-ok" style="flex:none;padding:0 24rpx;display:flex;align-items:center;" bindtap="createGroup">新建</view>
    </view>
    <view style="margin-top:28rpx;text-align:center;">
      <view class="btn btn-cancel" bindtap="hideGroupMgr">关闭</view>
    </view>
  </view>
</view>

<!-- 删除分组确认 -->
<view wx:if="{{showDelGroupModal}}" class="modal-mask">
  <view class="modal modal-confirm">
    <view class="modal-title">确认删除分组</view>
    <view class="confirm-text">删除分组 <text style="color:var(--text);font-weight:600;">{{delGroupName}}</text>？<text style="display:block;font-size:24rpx;color:var(--text-dim);">组内基金将变为未分组</text></view>
    <view class="modal-btns">
      <view class="btn btn-cancel" bindtap="hideDelGroupModal">取消</view>
      <view class="btn btn-del" bindtap="executeDelGroup">确认删除</view>
    </view>
  </view>
</view>

<!-- 删除基金确认弹窗 -->
<view wx:if="{{showDeleteModal}}" class="modal-mask" bindtap="hideDeleteModal">
  <view class="modal modal-confirm" catch:tap="noop">
    <view class="modal-title">确认删除</view>
    <view class="confirm-text">确定要删除 <text style="color:var(--text);font-weight:600;">{{deleteName}}</text> 吗？</view>
    <view class="modal-btns">
      <view class="btn btn-cancel" bindtap="hideDeleteModal">取消</view>
      <view class="btn btn-del" bindtap="executeDelete">确认删除</view>
    </view>
  </view>
</view>

<!-- 新建分组快捷弹窗 -->
<view wx:if="{{showQuickGroup}}" class="modal-mask">
  <view class="modal">
    <view class="modal-title">新建分组</view>
    <input class="modal-input" placeholder="输入分组名称" placeholder-style="color:#6e7681" value="{{quickGroupName}}" bindinput="onQuickInput" maxlength="10"/>
    <view class="modal-btns">
      <view class="btn btn-cancel" bindtap="hideQuickGroup">取消</view>
      <view class="btn btn-ok" bindtap="confirmQuickGroup">确定</view>
    </view>
  </view>
</view>

<!-- 移动分组弹窗 -->
<view wx:if="{{showMoveModal}}" class="modal-mask" bindtap="hideMoveModal">
  <view class="modal" catch:tap="noop">
    <view class="modal-title">移动到分组</view>
    <view style="display:flex;flex-wrap:wrap;gap:16rpx;">
      <view class="mv-item {{moveTargetGroupId === '' ? 'mv-sel' : ''}}" bindtap="moveFundToGroup" data-id="">未分组</view>
      <view wx:for="{{groups}}" wx:key="id" class="mv-item {{moveTargetGroupId === item.id ? 'mv-sel' : ''}}" bindtap="moveFundToGroup" data-id="{{item.id}}">{{item.name}}</view>
    </view>
    <view style="margin-top:28rpx;text-align:center;">
      <view class="btn btn-cancel" bindtap="hideMoveModal">关闭</view>
    </view>
  </view>
</view>

<!-- 重命名分组弹窗 -->
<view wx:if="{{showRenameModal}}" class="modal-mask">
  <view class="modal">
    <view class="modal-title">重命名分组</view>
    <input class="modal-input" placeholder="输入新名称" placeholder-style="color:#6e7681" value="{{renameGroupName}}" bindinput="onRenameInput" maxlength="10"/>
    <view class="modal-btns">
      <view class="btn btn-cancel" bindtap="hideRenameModal">取消</view>
      <view class="btn btn-ok" bindtap="confirmRenameTab">确定</view>
    </view>
  </view>
</view>
