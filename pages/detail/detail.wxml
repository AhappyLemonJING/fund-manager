<!-- 详情页 - 基金分析 -->
<navigation-bar title="{{name}}" back="{{true}}" color="white" background="#0d1117"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list"
  refresher-enabled refresher-triggered="{{refreshing}}"
  bindrefresherrefresh="onRefresh" refresher-threshold="80">
  <!-- 基金头部 -->
  <view class="d-header">
    <view class="d-code">{{code}}</view>
    <view class="d-name">{{name}}</view>
    <view class="d-nav-row">
      <text class="d-nav-val">{{nav}}</text>
      <text class="{{up ? 'red' : 'green'}}" style="font-size:36rpx;font-weight:700;">
        {{changeStr}}
      </text>
    </view>
    <view wx:if="{{navDate}}" class="d-date">净值日期: {{navDate}}
      <text wx:if="{{lastUpdateTime}}" style="margin-left:16rpx;color:var(--text-dim);">刷新 {{lastUpdateTime}}</text>
    </view>
  </view>

  <!-- 关联板块 -->
  <view class="section">
    <view class="sec-title">关联板块</view>
    <view wx:if="{{loadingHoldings}}" class="loading-line">加载中...</view>
    <view wx:elif="{{holdingsError}}" class="error-line">{{holdingsError}}</view>
    <view wx:elif="{{sectors.length > 0}}" class="tag-row">
      <text wx:for="{{sectors}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
    <view wx:else class="empty-line">暂无板块数据</view>
  </view>

  <!-- 重仓股及新闻 -->
  <view class="section">
    <view class="sec-title">
      重仓股及近期公告
      <text wx:if="{{loadingNews}}" class="loading-tag">拉取中...</text>
      <text wx:if="{{loadingAnalysis}}" class="loading-tag">AI分析中...</text>
      <text wx:elif="{{stats}}" class="stats-tag">利好{{stats.bullish}} / 利空{{stats.bearish}} / 中性{{stats.neutral}}</text>
    </view>
    <view wx:if="{{newsError}}" class="error-line">{{newsError}}</view>
    <view wx:for="{{stocks}}" wx:key="code" class="holding">
      <view class="hold-top">
        <text class="hold-name">{{item.name}} ({{item.code}})</text>
        <text class="hold-wt">持仓 {{item.weight}}%</text>
      </view>
      <block wx:if="{{newsMap[item.code] && newsMap[item.code].length > 0}}">
        <view wx:for="{{newsMap[item.code]}}" wx:key="title" wx:for-item="n" class="news-item">
          <view class="news-body {{n.stale ? 'news-stale' : ''}}">
            <text class="news-text">{{n.title}}</text>
            <text wx:if="{{n.timeAgo}}" class="news-time">{{n.timeAgo}}</text>
            <text wx:if="{{n.reason}}" class="news-reason">{{n.reason}}</text>
          </view>
          <text class="news-tag {{n.type === 'bullish' ? 't-bull' : n.type === 'bearish' ? 't-bear' : 't-neu'}}">
            <text wx:if="{{n.source === 'wscn'}}" class="news-source">快讯</text>            {{n.type === 'bullish' ? '利好' : n.type === 'bearish' ? '利空' : '中性'}}
          </text>
        </view>
      </block>
      <view wx:else style="font-size:24rpx;color:var(--text-dim);padding:12rpx 0;">近7日无相关公告</view>
    </view>
  </view>

  <!-- 综合建议 -->
  <view wx:if="{{suggest}}" class="rec {{suggestClass}}">
    <view wx:if="{{loadingAnalysis}}" class="loading-line">AI 分析中...</view>
    <block wx:else>
      <view class="rec-label">综合分析</view>
      <view class="rec-action {{suggestClass}}">{{suggestLabel}}</view>
      <view class="rec-reason">{{suggest.reason}}</view>
    </block>
  </view>
</scroll-view>
