page { background: var(--bg); width: 100%; overflow-x: hidden; }

.search-bar {
  padding: 16rpx 32rpx 20rpx;
  position: relative; z-index: 10;
}
.search-box {
  position: relative;
  background: var(--bg-input); border: 1px solid var(--border);
  border-radius: 24rpx; height: 72rpx;
}
.search-icon {
  position: absolute; left: 28rpx; top: 50%; transform: translateY(-50%);
  font-size: 28rpx; opacity: 0.5; z-index: 1; line-height: 1;
}
.search-input {
  width: 100%; height: 72rpx; font-size: 28rpx; color: var(--text);
  padding-left: 72rpx; padding-right: 72rpx;
  box-sizing: border-box; background: transparent;
}
.search-clear {
  position: absolute; right: 28rpx; top: 50%; transform: translateY(-50%);
  font-size: 24rpx; color: var(--text-dim); z-index: 2;
  padding: 8rpx; line-height: 1;
}

.search-results-panel {
  flex: 1; background: var(--bg);
  overflow-y: auto;
  border-top: 1px solid var(--border);
}
.search-result-list { padding: 16rpx 32rpx; }
.sr-item {
  display: flex; align-items: center;
  padding: 24rpx 0; border-bottom: 1px solid var(--border);
  gap: 16rpx;
}
.sr-info { flex: 1; min-width: 0; }
.sr-code { font-size: 22rpx; color: var(--text-dim); display: block; letter-spacing: 2rpx; }
.sr-name { font-size: 28rpx; font-weight: 600; display: block; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sr-type { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; }
.sr-add {
  padding: 12rpx 24rpx; background: rgba(212,168,83,0.15);
  color: var(--accent); border-radius: 20rpx; font-size: 24rpx;
  font-weight: 600; flex-shrink: 0; border: 1px solid rgba(212,168,83,0.3);
}
.sr-added {
  font-size: 24rpx; color: var(--text-dim); flex-shrink: 0;
}
.scrollarea { height: calc(100vh - 360rpx); }


.filter-tab-bar {
  white-space: nowrap; padding: 0 24rpx 16rpx;
  flex: none; height: 64rpx;
}
.filter-tab {
  display: inline-block; padding: 10rpx 22rpx; font-size: 24rpx;
  color: var(--text-secondary); border-radius: 24rpx; margin-right: 12rpx;
  background: var(--bg-input); border: 1px solid var(--border);
  transition: all 0.15s;
}
.filter-tab-active {
  background: var(--accent); color: #000; border-color: var(--accent);
  font-weight: 600; margin-right: 0;
}

.toolbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 32rpx 12rpx;
}
.sort-trigger {
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 22rpx; background: var(--bg-input);
  border: 1px solid var(--border); border-radius: 20rpx;
  font-size: 24rpx; color: var(--text-secondary);
}
.sort-arrow { font-size: 18rpx; color: var(--text-dim); margin-left: 4rpx; }

.sort-dropdown {
  position: absolute; top: 340rpx; left: 32rpx; z-index: 60;
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 16rpx; overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.4);
  width: 240rpx;
}
.sort-option {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 28rpx; font-size: 26rpx; color: var(--text-secondary);
  border-bottom: 1px solid var(--border);
}
.sort-option:last-child { border-bottom: none; }
.sort-option-active { color: var(--accent); font-weight: 600; background: rgba(212,168,83,0.06); }
.sort-check { font-size: 24rpx; }

.state-box { text-align: center; padding: 240rpx 0; }
.state-icon { font-size: 80rpx; opacity: 0.3; display: block; }
.state-text { margin-top: 20rpx; color: var(--text-secondary); font-size: 28rpx; }
.state-sub { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--text-dim); }
.retry-btn {
  display: inline-block; margin-top: 36rpx; padding: 18rpx 56rpx;
  background: var(--accent); color: #000; border-radius: 40rpx;
  font-weight: 600; font-size: 28rpx;
}

.card {
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 24rpx; padding: 16rpx 28rpx 10rpx;
  margin: 0 32rpx 16rpx;
  transition: all 0.2s;
}
.card:active { opacity: 0.85; transform: scale(0.985); }

.card-row { display: flex; justify-content: space-between; align-items: flex-start; }
.card-left { flex: 1; min-width: 0; overflow: hidden; display: flex; flex-direction: column; gap: 2rpx; }
.card-code { font-size: 22rpx; color: var(--text-dim); letter-spacing: 2rpx; line-height: 1.2; }
.card-name {
  font-size: 30rpx; font-weight: 700; margin-top: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; line-height: 1.2;
}
.card-right { text-align: right; flex-shrink: 0; margin-left: 16rpx; display: flex; flex-direction: column; gap: 0; }
.card-nav { font-size: 34rpx; font-weight: 700; line-height: 1.1; }
.card-daily { font-size: 26rpx; font-weight: 600; line-height: 1.1; margin-top: 0; }

.card-perf {
  display: flex; gap: 12rpx; padding: 6rpx 0;
  border-top: 1px solid var(--border); margin-top: 6rpx;
}
.perf-item { flex: 1; text-align: center; min-width: 0; }
.perf-label { font-size: 20rpx; color: var(--text-dim); margin-bottom: 2rpx; line-height: 1.2; }
.perf-val { font-size: 24rpx; font-weight: 700; line-height: 1.2; }
.perf-size { color: var(--text-secondary); }

.card-actions {
  display: flex; align-items: center; gap: 12rpx;
  padding-top: 6rpx; border-top: 1px solid var(--border);
}
.ca-btn {
  flex: 1; text-align: center; padding: 12rpx 0;
  border-radius: 16rpx; font-size: 24rpx; font-weight: 600;
}
.ca-add {
  background: rgba(212,168,83,0.15); color: var(--accent);
  border: 1px solid rgba(212,168,83,0.3);
}
.ca-added { color: var(--text-dim); }

.load-more {
  text-align: center; padding: 24rpx 0 48rpx;
  font-size: 24rpx; color: var(--text-secondary);
}

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 200;
  display: flex; align-items: center;
  background: var(--bg-card); border-top: 1px solid var(--border);
  padding: 12rpx 0; padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}
.bb-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 6rpx 0; }
.bb-icon { font-size: 36rpx; }
.bb-label { font-size: 30rpx; color: var(--text-dim); font-weight: 500; }
.bb-active .bb-label { color: var(--accent); font-weight: 700; }
